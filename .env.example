# Firebase OAuth Credentials
# Get these from Google Cloud Console: https://console.cloud.google.com/
#
# Steps:
# 1. Create a new project or select existing
# 2. Enable Firebase Management API
# 3. Go to APIs & Services > Credentials
# 4. Create OAuth 2.0 Client ID (Desktop app type)
# 5. Set authorized redirect URI: http://localhost:8080/oauth2callback
# 6. Copy the Client ID and Client Secret below
#
# These credentials will be embedded in the built CLI distribution.
# This is secure for public CLI tools - see OAuth 2.0 "public client" documentation.

FIREBASE_OAUTH_CLIENT_ID=your-client-id-here.apps.googleusercontent.com
FIREBASE_OAUTH_CLIENT_SECRET=your-client-secret-here
